# 複製這個檔案並改名為 .env，再填入真實值（.env 不要上傳到 GitHub）
# 變數名稱與老師範例 DB_CLASS_2026-postgres 相同

# 課程資料庫（需在校內網路或 VPN 才連得到）
DB_HOST=140.117.68.35
DB_PORT=5432
DB_USER=project_8
DB_PASSWORD=
DB_NAME=project_8

# JWT 簽章用的密鑰，請換成一長串隨機字元
SECRET_KEY=change-me-to-a-long-random-string

# 允許呼叫 API 的前端網址（逗號分隔）。放上 GitHub Pages 後，加上你的 Pages 網址
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# 後端埠號
PORT=5000
